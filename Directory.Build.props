<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Textos de domínio em português: CA1707/CA1711 etc. não ajudam aqui. -->
    <NoWarn>$(NoWarn);CA1707;CA1711;CA1716;CA1720;CA1724;CA1848;CA1873;CA2007;CA1054;CA1055;CA1056;CA1062;CA1303;CA1305;CA1307;CA1308;CA1309;CA1310;CA1311;CA1031;CA1819;CA1002;CA1034;CA1515;CA5394;CA1032;CA1064;CA2227;CA1822;CA1860;CA1865;CA1866;CA1869</NoWarn>
  </PropertyGroup>
</Project>
