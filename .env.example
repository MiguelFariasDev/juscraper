# Chaves aceitas em X-Api-Key, separadas por vírgula. VAZIO = API aberta (só para dev local).
JUSCRAPER_API_KEYS=
# Segundos que um resultado fica em cache (inclui "não encontrado"). 0 desliga.
JUSCRAPER_CACHE_TTL=1800
# Segundos entre requisições ao MESMO portal, e requisições simultâneas por portal.
JUSCRAPER_INTERVALO_MINIMO=1.0
JUSCRAPER_CONCORRENCIA_POR_HOST=2
# Timeout por requisição ao portal e tentativas em falha transitória.
JUSCRAPER_TIMEOUT=30
JUSCRAPER_TENTATIVAS=3
# Teto de páginas de movimentações por processo (cada página = 1 requisição).
JUSCRAPER_MAX_PAGINAS_MOVIMENTACOES=100
