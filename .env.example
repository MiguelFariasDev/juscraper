# Convenção do .NET: seções separadas por "__".
# Chaves aceitas em X-Api-Key, separadas por vírgula. VAZIO = API aberta (só para dev local).
Juscraper__Api__ApiKeys=
# Tempo de cache de um resultado (inclui "não encontrado"). 00:00:00 desliga.
Juscraper__CacheTtl=00:30:00
# Intervalo entre requisições ao MESMO portal e requisições simultâneas por portal.
Juscraper__Http__PoliticaPadrao__IntervaloMinimo=00:00:01
Juscraper__Http__PoliticaPadrao__Concorrencia=2
# Timeout por requisição ao portal e tentativas em falha transitória.
Juscraper__Http__Timeout=00:00:30
Juscraper__Http__Tentativas=3
# Teto de páginas de movimentações por processo (cada página = 1 requisição).
Juscraper__MaxPaginasMovimentacoes=100
# Tribunais PJe com a nova consulta pública, declarados sem nova versão (ver `juscraper detectar-pje`).
Juscraper__PjeRest=
